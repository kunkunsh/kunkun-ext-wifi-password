{
  "$schema": "../../packages/sdk/manifest-schema.json",
  "name": "kunkun-ext-wifi-password",
  "license": "MIT",
  "version": "0.2.0",
  "description": "Show saved Wi-Fi passwords and connection QR codes",
  "type": "module",
  "repository": "https://github.com/kunkunsh/kunkun-ext-wifi-password",
  "kunkun": {
    "name": "Wifi Password",
    "shortDescription": "Show saved Wi-Fi passwords",
    "longDescription": "List saved Wi-Fi networks, copy passwords, and generate Wi-Fi QR payloads for quick connection.",
    "identifier": "wifi-password",
    "permissions": [
      "clipboard-write",
      "notifications",
      "environment",
      {
        "permission": "shell",
        "commands": [
          {
            "program": "networksetup"
          },
          {
            "program": "security"
          },
          {
            "program": "netsh"
          },
          {
            "program": "nmcli"
          }
        ]
      }
    ],
    "demoImages": [],
    "icon": {
      "type": "iconify",
      "value": "material-symbols:wifi-rounded"
    },
    "commands": [
      {
        "name": "show-wifi-password",
        "title": "Show Wifi Password",
        "description": "List saved Wi-Fi networks and copy their passwords",
        "mode": "worker-view",
        "main": "dist/index.js"
      }
    ]
  },
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun build.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kunkunsh/sdk": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "catalog:",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
